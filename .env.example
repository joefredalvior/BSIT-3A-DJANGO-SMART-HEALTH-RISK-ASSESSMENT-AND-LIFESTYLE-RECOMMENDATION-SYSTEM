# Copy to .env and adjust for your machine.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE empty to use the bundled SQLite database.
# Use django.db.backends.mysql for MySQL/XAMPP.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=healthwise
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONN_MAX_AGE=60

# Email (console backend is used automatically when DEBUG=1).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=HealthWise <no-reply@healthwise.local>

# Privacy and reminders.
PRIVACY_VERSION=1.0
ACCOUNT_REMINDER_DAYS=30
SITE_URL=https://healthwise.local

# SMS reminders (console prints messages instead of sending them).
SMS_BACKEND=console

# Data retention cleanup defaults.
AUDIT_RETENTION_DAYS=365
LOGIN_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=730

# Production security (also set these in settings_production).
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=0
# DJANGO_BEHIND_PROXY=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Shared cache for rate limiting across workers.
# Run: python manage.py createcachetable
# DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# DJANGO_CACHE_LOCATION=healthwise_cache
