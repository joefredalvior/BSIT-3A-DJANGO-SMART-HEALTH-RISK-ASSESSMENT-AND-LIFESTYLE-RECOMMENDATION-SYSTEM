# Copy to .env and adjust for your machine.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE empty to use the bundled SQLite database.
